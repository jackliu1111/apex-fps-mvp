{
  "name": "apex-highlight-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.13",
  "engines": { "bun": ">=1.3.13" },
  "scripts": {
    "dev": "bun scripts/build-web.ts && bun src/main.ts",
    "start": "bun scripts/build-web.ts && bun src/main.ts",
    "build": "bun scripts/build.ts",
    "package": "bun scripts/package.ts",
