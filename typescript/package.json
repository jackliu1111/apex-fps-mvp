    "check": "bun scripts/build-web.ts && tsc --noEmit",
    "verify": "bun scripts/verify.ts"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "fft.js": "^4.0.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
