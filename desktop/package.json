{
  "name": "apex-model-desktop",
  "version": "0.1.0",
  "description": "Apex local audio-model review desktop",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "build:mac": "electron-builder --mac --arm64",
    "build:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.apex.model",
    "productName": "Apex Model Review",
    "asar": true,
    "directories": {
      "output": "../dist/model-desktop"
    },
    "files": [
      "*.cjs",
      "package.json",
      "ui/**/*",
      "host.html",
      "host.js",
      "node_modules/react/umd/react.production.min.js",
      "node_modules/react-dom/umd/react-dom.production.min.js",
      "!build-native.cjs"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "runtime",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "dir"
      ],
      "category": "public.app-category.video"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "beforePack": "./build-native.cjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
